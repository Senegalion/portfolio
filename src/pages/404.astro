---
import { ArrowLeft } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import en from "../i18n/en";
import pl from "../i18n/pl";
---

<BaseLayout title={pl.notFound.title} minimal>
  <main id="main" class="relative grid min-h-svh place-items-center overflow-hidden px-4 py-16">
    <div class="w-full max-w-xl text-center">
      <h1 class="display text-[clamp(7rem,30vw,14rem)] text-fg">4<em class="text-accent">0</em>4</h1>
      <p class="mt-6 text-xl leading-8 text-fg">{pl.notFound.description}</p>
      <p lang="en" class="mt-2 text-sm text-muted">{en.notFound.description}</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary"><ArrowLeft size={18} aria-hidden="true" />{pl.notFound.home}</a>
        <a href="/en/" class="btn btn-secondary" lang="en">{en.notFound.home}</a>
      </div>
    </div>
  </main>
</BaseLayout>
