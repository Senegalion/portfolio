---
import { WifiOff } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import en from "../i18n/en";
import pl from "../i18n/pl";
---

<!-- Served by the service worker when a page is requested offline and is not cached. Bilingual on purpose. -->
<BaseLayout title={`${pl.offline.title} · ${en.offline.title}`} minimal>
  <main id="main" class="grid min-h-svh place-items-center px-4 py-16">
    <div class="w-full max-w-lg text-center">
      <span class="mx-auto grid size-16 place-items-center rounded-2xl border border-amber-400/25 bg-amber-400/10 text-amber-300">
        <WifiOff size={28} aria-hidden="true" />
      </span>
      <h1 class="mt-8 text-3xl font-bold tracking-tight text-white sm:text-4xl">{pl.offline.title}</h1>
      <p class="mt-4 leading-7 text-slate-400">{pl.offline.description}</p>
      <p lang="en" class="mt-6 text-sm leading-6 text-slate-500">
        <strong class="font-semibold text-slate-300">{en.offline.title}.</strong>
        {en.offline.description}
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <button type="button" class="btn btn-primary" onclick="location.reload()">
          {pl.offline.retry} · <span lang="en">{en.offline.retry}</span>
        </button>
        <a href="/" class="btn btn-secondary">{pl.offline.home}</a>
      </div>
    </div>
  </main>
</BaseLayout>
