---
import { Menu, Moon, Sun, X } from "lucide-astro";
import { SITE, localePath } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);

const navigation = [
  { label: t.navigation.about, href: "#about" },
  { label: t.navigation.experience, href: "#experience" },
  { label: t.navigation.projects, href: "#projects" },
  { label: t.navigation.skills, href: "#skills" },
  { label: t.navigation.education, href: "#education" },
];

const languages = [
  { code: "pl", label: "PL", name: "Polski" },
  { code: "en", label: "EN", name: "English" },
] as const;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent data-menu-open:bg-bg transition-[background-color,border-color] duration-300 data-scrolled:border-line data-scrolled:bg-bg/85 data-scrolled:backdrop-blur-xl"
>
  <div class="container-page flex h-18 items-center justify-between gap-4">
    <a href="#top" class="group inline-flex items-baseline gap-2 text-fg" title={t.navigation.home}>
      <span class="font-display text-[1.65rem] leading-none tracking-tight">Łukasz Pelikan</span>
      <span class="size-1.5 rounded-full bg-accent transition-transform duration-300 group-hover:scale-150" aria-hidden="true"></span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t.navigation.mainNavigation}>
      {
        navigation.map(({ label, href }) => (
          <a
            href={href}
            data-nav-link
            class="link text-sm font-medium text-muted hover:text-fg data-active:text-fg data-active:[background-size:100%_1px]"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <div class="hidden items-center text-sm font-medium sm:flex" role="group" aria-label={t.navigation.language}>
        {
          languages.map(({ code, label, name }, index) => (
            <>
              {index > 0 && <span class="px-1 text-line-strong" aria-hidden="true">/</span>}
              <a
                href={localePath(code)}
                hreflang={code}
                lang={code}
                data-lang-link
                title={name}
                aria-current={lang === code ? "page" : undefined}
                class:list={["px-1 py-2 transition", lang === code ? "text-fg" : "text-subtle hover:text-fg"]}
              >
                {label}
              </a>
            </>
          ))
        }
      </div>

      <button
        type="button"
        data-action="toggle-theme"
        class="icon-btn"
        data-label-dark={t.navigation.themeToDark}
        data-label-light={t.navigation.themeToLight}
        aria-label={t.navigation.themeToLight}
        title={t.navigation.themeToLight}
      >
        <Sun size={19} class="theme-icon-sun" aria-hidden="true" />
        <Moon size={18} class="theme-icon-moon hidden" aria-hidden="true" />
      </button>

      <a href="#contact" class="btn btn-primary hidden min-h-10 px-5 py-2 text-sm md:inline-flex">
        {t.navigation.contactButton}
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="icon-btn lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t.navigation.openMenu}
        data-open-label={t.navigation.openMenu}
        data-close-label={t.navigation.closeMenu}
      >
        <Menu id="menu-open-icon" size={22} aria-hidden="true" />
        <X id="menu-close-icon" class="hidden" size={22} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="scroll-progress"
    class="absolute inset-x-0 -bottom-px h-px origin-left scale-x-0 bg-accent"
    aria-hidden="true"
  >
  </div>

  <div
    id="mobile-menu"
    class="hidden h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-line bg-bg lg:hidden"
  >
    <nav class="container-page flex flex-col py-6" aria-label={t.navigation.mobileNavigation}>
      {
        [...navigation, { label: t.navigation.contact, href: "#contact" }].map(({ label, href }, index) => (
          <a
            href={href}
            data-nav-link
            class="flex items-baseline gap-4 border-b border-line py-4 font-display text-4xl text-fg transition hover:text-accent data-active:text-accent"
          >
            <span class="font-sans text-xs text-subtle tabular-nums">0{index + 1}</span>
            {label}
          </a>
        ))
      }

      <div class="mt-8 grid grid-cols-2 gap-2" role="group" aria-label={t.navigation.language}>
        {
          languages.map(({ code, name }) => (
            <a
              href={localePath(code)}
              hreflang={code}
              lang={code}
              data-lang-link
              aria-current={lang === code ? "page" : undefined}
              class:list={[
                "grid min-h-12 place-items-center rounded-full border text-sm font-semibold",
                lang === code ? "border-fg bg-fg text-bg" : "border-line-strong text-muted",
              ]}
            >
              {name}
            </a>
          ))
        }
      </div>

      <a href={`mailto:${SITE.email}`} class="btn btn-primary mt-3">
        {t.navigation.mobileContact}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#mobile-menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const header = document.querySelector<HTMLElement>("#site-header");
  const openIcon = document.querySelector<HTMLElement>("#menu-open-icon");
  const closeIcon = document.querySelector<HTMLElement>("#menu-close-icon");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
    header?.toggleAttribute("data-menu-open", open);
    document.documentElement.style.overflow = open ? "hidden" : "";
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", (open ? button.dataset.closeLabel : button.dataset.openLabel) ?? "Menu");
  };

  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
  window.addEventListener("resize", () => window.innerWidth >= 1024 && setOpen(false));
</script>
