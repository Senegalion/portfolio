---
import { ArrowUp } from "lucide-astro";
import { BUILD } from "../../data/build";
import { SITE, pagePath, type PageKey } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const f = t.footer;
const year = new Date().getFullYear();

const pages: { page: PageKey; label: string }[] = [
  { page: "about", label: t.navigation.about },
  { page: "experience", label: t.navigation.experience },
  { page: "projects", label: t.navigation.projects },
  { page: "skills", label: t.navigation.skills },
  { page: "education", label: t.navigation.education },
  { page: "teams", label: t.navigation.teams },
  { page: "contact", label: t.navigation.contact },
];

const links = [
  { label: f.linkedin, href: SITE.linkedin },
  { label: f.github, href: SITE.github },
];
---

<footer class="force-dark border-t border-line bg-bg pt-16 pb-10">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <a href={pagePath("home", lang)} class="text-lg font-semibold tracking-tight text-fg">{SITE.name}</a>
        <p class="mt-3 max-w-sm leading-7 text-muted">{t.hero.lead}</p>
        <a href={`mailto:${SITE.email}`} class="link mt-5 inline-block font-medium text-fg">{SITE.email}</a>
      </div>

      <nav aria-label={t.navigation.mainNavigation}>
        <ul class="grid gap-2.5 text-sm">
          {
            pages.map(({ page, label }) => (
              <li>
                <a href={pagePath(page, lang)} class="text-muted transition hover:text-fg">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="grid content-start gap-2.5 text-sm">
        {
          links.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noreferrer" class="text-muted transition hover:text-fg">
                {label} ↗
              </a>
            </li>
          ))
        }
        <li><a href={SITE.phoneHref} class="text-muted transition hover:text-fg">{SITE.phone}</a></li>
      </ul>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-sm text-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. {f.copyright}</p>
      <p class="inline-flex flex-wrap items-center gap-x-4 gap-y-1">
        <button type="button" data-open-palette class="hidden items-center gap-1.5 transition hover:text-fg sm:inline-flex">
          <kbd data-mod-key>⌘K</kbd>
          {f.shortcut}
        </button>
        <a
          href={`https://github.com/Senegalion/portfolio/commit/${BUILD.commit}`}
          target="_blank"
          rel="noreferrer"
          class="tabular-nums transition hover:text-fg"
          title={BUILD.date}
        >
          {f.build} {BUILD.commit}
        </a>
      </p>
    </div>
  </div>
</footer>

<button
  id="back-to-top"
  type="button"
  data-action="back-to-top"
  tabindex="-1"
  aria-label={f.backToTop}
  class="pointer-events-none fixed right-4 bottom-4 z-40 grid size-11 translate-y-4 place-items-center rounded-lg border border-line-strong bg-bg/90 text-fg opacity-0 shadow-lg backdrop-blur transition hover:border-fg data-visible:pointer-events-auto data-visible:translate-y-0 data-visible:opacity-100 sm:right-6 sm:bottom-6"
>
  <ArrowUp size={20} aria-hidden="true" />
</button>
