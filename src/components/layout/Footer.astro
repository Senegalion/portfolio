---
import { ArrowUp, Copy, Download, Github, GitCommitHorizontal, Linkedin, Mail, Phone } from "lucide-astro";
import { BUILD, hasCv } from "../../data/build";
import { SITE } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const f = t.footer;
const year = new Date().getFullYear();
---

<footer id="contact" class="relative overflow-hidden border-t border-white/5 bg-ink-950 pt-20 pb-10" aria-labelledby="contact-title">
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-0 size-[36rem] -translate-x-1/2 glow" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:items-end">
      <div data-reveal>
        <p class="eyebrow">{f.contact}</p>
        <h2 id="contact-title" class="heading-2 max-w-3xl sm:text-5xl">{f.title}</h2>
        <p class="lead">{f.description}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={`mailto:${SITE.email}`} class="btn btn-primary">
            <Mail size={18} aria-hidden="true" />
            {f.writeEmail}
          </a>
          <button type="button" class="btn btn-secondary" data-action="copy-email" data-email={SITE.email}>
            <Copy size={17} aria-hidden="true" />
            <span class="font-mono text-sm">{SITE.email}</span>
            <span class="sr-only">— {f.copyEmail}</span>
          </button>
          <a href={SITE.phoneHref} class="btn btn-secondary">
            <Phone size={17} aria-hidden="true" />
            {SITE.phone}
          </a>
          {
            hasCv && (
              <a href={SITE.cvPath} download class="btn btn-secondary">
                <Download size={17} aria-hidden="true" />
                {t.hero.cv}
              </a>
            )
          }
        </div>
      </div>

      <div class="flex gap-3" data-reveal>
        <a href={SITE.github} target="_blank" rel="noreferrer" class="icon-btn size-12 border border-white/10" aria-label={f.github}>
          <Github size={20} aria-hidden="true" />
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="icon-btn size-12 border border-white/10" aria-label={f.linkedin}>
          <Linkedin size={20} aria-hidden="true" />
        </a>
        <a href="#top" class="icon-btn size-12 border border-white/10" aria-label={f.backToTop}>
          <ArrowUp size={20} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-white/5 pt-6 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. {f.copyright}</p>
      <p class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
        <span>{f.madeWith}</span>
        <span class="inline-flex items-center gap-1.5" title={BUILD.date}>
          <GitCommitHorizontal size={14} aria-hidden="true" />
          {f.build}
          <a
            href={`https://github.com/Senegalion/portfolio/commit/${BUILD.commit}`}
            target="_blank"
            rel="noreferrer"
            class="text-slate-400 underline-offset-4 hover:text-white hover:underline"
          >
            {BUILD.commit}
          </a>
          · {BUILD.date}
        </span>
      </p>
    </div>
  </div>
</footer>

<button
  id="back-to-top"
  type="button"
  data-action="back-to-top"
  tabindex="-1"
  aria-label={f.backToTop}
  class="fixed right-4 bottom-4 z-40 grid size-12 translate-y-4 place-items-center rounded-2xl border border-white/10 bg-ink-850/90 text-slate-300 opacity-0 shadow-xl shadow-black/40 backdrop-blur transition pointer-events-none hover:text-white data-visible:pointer-events-auto data-visible:translate-y-0 data-visible:opacity-100 sm:right-6 sm:bottom-6"
>
  <ArrowUp size={20} aria-hidden="true" />
</button>
