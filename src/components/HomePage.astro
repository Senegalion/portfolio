---
import Footer from "./layout/Footer.astro";
import Header from "./layout/Header.astro";
import About from "./sections/About.astro";
import Activities from "./sections/Activities.astro";
import Education from "./sections/Education.astro";
import Experience from "./sections/Experience.astro";
import Hero from "./sections/Hero.astro";
import Projects from "./sections/Projects.astro";
import Research from "./sections/Research.astro";
import Skills from "./sections/Skills.astro";
import TechMarquee from "./sections/TechMarquee.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />

  <main id="main" tabindex="-1">
    <Hero />
