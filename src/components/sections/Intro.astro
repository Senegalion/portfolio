---
import Section from "../ui/Section.astro";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const i = t.intro;
---

<Section id="intro" index={i.index} label={i.badge} title={i.title} description={i.lead}>
  <ol class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
    {
      i.items.map(({ title, text, tech }, index) => (
        <li
          class="group flex flex-col bg-bg p-7 transition-colors duration-500 hover:bg-surface sm:p-8"
          data-reveal
          style={`--reveal-delay:${index * 90}ms`}
        >
          <span class="font-display text-6xl leading-none text-accent italic transition-transform duration-500 group-hover:-translate-y-1">
            {index + 1}
          </span>
          <h3 class="mt-10 text-xl font-semibold tracking-tight text-fg">{title}</h3>
          <p class="mt-3 leading-7 text-muted">{text}</p>
          <div class="mt-auto pt-8">
            <p class="border-t border-line pt-5 text-sm text-subtle">
              <span class="sr-only">{i.techLabel}: </span>
              {tech}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
