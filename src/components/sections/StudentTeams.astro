---
import { Star } from "lucide-astro";
import Section from "../ui/Section.astro";
import LogoTile from "../ui/LogoTile.astro";
import TechChip from "../ui/TechChip.astro";
import { ORGS, type OrgKey } from "../../data/orgs";
import { formatPeriod } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const s = t.teams;
const period = (from: string, to: string | null) => formatPeriod(from, to, lang, s.present);

type Team = {
  org: "solarTeam" | "kino" | "ubicomp";
  from: string;
  to: string | null;
  stack?: string[];
};

// Ordered by importance: Lodz Solar Team is the main one and gets the featured card.
const [main, ...others]: Team[] = [
  { org: "solarTeam", from: "2026-11", to: null },
  { org: "kino", from: "2026-10", to: null, stack: ["Python", "Machine Learning", "Generative AI"] },
  { org: "ubicomp", from: "2024-02", to: "2025-01", stack: ["Python", "OptiTrack SDK", "Git", "GitHub"] },
];

const info = (org: OrgKey & Team["org"]) => ({ ...s.items[org], name: ORGS[org].name, url: ORGS[org].url });
const featured = info(main.org);
---

<Section id="teams" index={s.index} label={s.badge} title={s.title} description={s.description}>
  <!-- Main team: a large featured card. -->
  <article class="force-dark mt-16 overflow-hidden rounded-xl border border-line bg-bg text-fg" data-reveal>
    <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <a
        href={featured.url}
        target="_blank"
        rel="noreferrer"
        class="solar-panel grid min-h-56 place-items-center p-10 sm:p-14"
        title={featured.name}
      >
        <img src={ORGS.solarTeam.logo} alt={featured.name} loading="lazy" decoding="async" class="h-auto w-full max-w-md" />
      </a>
      <div class="flex flex-col p-7 sm:p-10">
        <p class="flex flex-wrap items-center gap-3 text-sm">
          <span class="inline-flex items-center gap-1.5 rounded-md bg-accent px-2 py-0.5 text-xs font-semibold text-on-accent">
            <Star size={12} aria-hidden="true" />
            {s.main}
          </span>
          <span class="inline-flex items-center gap-2 text-ok">
            <span class="status-dot" aria-hidden="true" />
            {s.current}
          </span>
          <span class="text-muted tabular-nums">{period(main.from, main.to)}</span>
        </p>
        <h3 class="mt-6 font-display text-[clamp(1.875rem,3.5vw,2.5rem)] leading-tight">{featured.name}</h3>
        <p class="mt-2 text-lg font-semibold">{featured.role}</p>
        <p class="mt-1 text-sm text-accent">{featured.kind}</p>
        <p class="mt-5 leading-7 text-pretty text-muted">{featured.summary}</p>
        <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
          {
            featured.highlights.map((item) => (
              <li class="flex gap-3 text-[0.95rem] leading-7 text-muted">
                <span class="mt-[0.7rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>

  <!-- Other teams: editorial rows, like the experience timeline. -->
  <ol class="mt-12 border-b border-line">
    {
      others.map(({ org, from, to, stack }) => {
        const team = info(org);
        const current = to === null;
        return (
          <li class="group grid gap-6 border-t border-line py-10 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10" data-reveal>
            <div class="flex flex-row flex-wrap items-baseline gap-x-4 gap-y-1 md:flex-col md:gap-2">
              <LogoTile org={org} link class="mb-3 h-16 w-full max-w-44 basis-full md:basis-auto" />
              <p class="text-sm font-semibold text-fg tabular-nums">{period(from, to)}</p>
              {current && (
                <p class="inline-flex items-center gap-2 text-sm text-ok">
                  <span class="status-dot" aria-hidden="true" />
                  {s.current}
                </p>
              )}
            </div>

            <div class="min-w-0">
              <p class="text-sm font-medium text-accent">{team.kind}</p>
              <h3 class="mt-2 font-display text-[clamp(1.5rem,3vw,2rem)] leading-tight text-fg transition-transform duration-500 group-hover:translate-x-1">
                {team.name}
              </h3>
              <p class="mt-2 text-lg font-semibold text-fg">{team.role}</p>
              <p class="mt-4 max-w-2xl text-lg leading-8 text-pretty text-muted">{team.summary}</p>

              <h4 class="mt-7 text-sm font-semibold text-fg">{s.focus}</h4>
              <ul class="mt-3 space-y-2.5">
                {team.highlights.map((item) => (
                  <li class="flex gap-3 text-[0.95rem] leading-7 text-muted">
                    <span class="mt-[0.7rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              {stack && (
                <>
                  <h4 class="sr-only">{s.stack}</h4>
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {stack.map((name) => (
                      <li>
                        <TechChip name={name} />
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>

<style>
  .solar-panel {
    background: linear-gradient(135deg, #b014e8 0%, #3a1196 40%, #160b63 75%, #0d0840 100%);
  }
</style>
