---
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const r = t.research;

// Illustrative service-dependency graph: one root cause, symptoms propagating upstream.
const nodes = [
  { id: "gw", x: 60, y: 120, label: "gateway", state: "symptom" },
  { id: "orders", x: 175, y: 55, label: "orders", state: "symptom" },
  { id: "users", x: 175, y: 185, label: "users", state: "ok" },
  { id: "pay", x: 295, y: 55, label: "payments", state: "root" },
  { id: "notify", x: 295, y: 185, label: "notify", state: "ok" },
  { id: "db", x: 400, y: 120, label: "database", state: "ok" },
] as const;
const edges = [
  ["gw", "orders"],
  ["gw", "users"],
  ["orders", "pay"],
  ["users", "notify"],
  ["pay", "db"],
  ["notify", "db"],
  ["orders", "notify"],
] as const;
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const tone = { root: "danger", symptom: "warn", ok: "subtle" } as const;
const stroke = { danger: "stroke-danger", warn: "stroke-warn", subtle: "stroke-subtle" } as const;
const fill = { danger: "fill-danger", warn: "fill-warn", subtle: "fill-subtle" } as const;
const dot = { danger: "bg-danger", warn: "bg-warn", subtle: "bg-subtle" } as const;
---

<section id="research" class="inverted relative bg-bg py-20 text-fg md:py-28" aria-labelledby="research-title">
  <div class="container-page section-grid">
    <p class="label self-start lg:sticky lg:top-28" data-reveal>
      {r.badge}
    </p>

    <div class="grid min-w-0 items-center gap-12 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] xl:gap-16">
      <div data-reveal>
        <p class="inline-flex items-center gap-2 text-sm font-medium text-muted">
          <span class="status-dot bg-warn!" aria-hidden="true"></span>
          {r.status}
        </p>
        <h2 id="research-title" class="heading-2 mt-6" set:html={r.title} />
        <p class="lead">{r.description}</p>

        <div class="mt-10 border-t border-line pt-6">
          <h3 class="text-sm font-semibold text-fg">{r.technical}</h3>
          <p class="mt-2 max-w-xl text-[0.95rem] leading-7 text-muted">{r.technicalText}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {r.topics.map((topic) => <li class="tag">{topic}</li>)}
          </ul>
        </div>
      </div>

      <figure class="rounded-xl border border-line bg-surface p-5 sm:p-7" data-reveal style="--reveal-delay:120ms">
        <svg viewBox="0 0 460 240" class="h-auto w-full" role="img" aria-label={r.figureLabel}>
          <defs>
            <marker id="rca-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10z" class="fill-line-strong"></path>
            </marker>
          </defs>
          {
            edges.map(([from, to]) => {
              const a = byId[from];
              const b = byId[to];
              const hot = a.state !== "ok" && b.state !== "ok";
              return (
                <line
                  x1={a.x + 26}
                  y1={a.y}
                  x2={b.x - 30}
                  y2={b.y}
                  class={hot ? "stroke-warn" : "stroke-line-strong"}
                  stroke-width={hot ? 2 : 1.5}
                  stroke-dasharray={hot ? "5 4" : undefined}
                  marker-end="url(#rca-arrow)"
                />
              );
            })
          }
          {
            nodes.map((node) => {
              const c = tone[node.state];
              return (
                <g>
                  {node.state === "root" && (
                    <circle cx={node.x} cy={node.y} r="26" class="fill-danger" opacity="0.25">
                      <animate attributeName="r" values="22;36;22" dur="2.4s" repeatCount="indefinite" />
                      <animate attributeName="opacity" values=".35;0;.35" dur="2.4s" repeatCount="indefinite" />
                    </circle>
                  )}
                  <circle cx={node.x} cy={node.y} r="22" class:list={["fill-bg", stroke[c]]} stroke-width="2" />
                  <circle cx={node.x} cy={node.y} r="5" class={fill[c]} />
                  <text x={node.x} y={node.y + 40} text-anchor="middle" font-size="12" class="fill-muted">
                    {node.label}
                  </text>
                </g>
              );
            })
          }
        </svg>
        <figcaption class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-muted">
          {
            (["root", "symptom", "ok"] as const).map((state) => (
              <span class="inline-flex items-center gap-2">
                <span class:list={["size-2 rounded-full", dot[tone[state]]]} />
                {r.legend[state]}
              </span>
            ))
          }
        </figcaption>
      </figure>
    </div>
  </div>
</section>
