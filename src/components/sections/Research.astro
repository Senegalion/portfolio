---
import { Database, Microscope } from "lucide-astro";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const r = t.research;

// Illustrative service-dependency graph: one root cause, symptoms propagating upstream.
const nodes = [
  { id: "gw", x: 60, y: 120, label: "gateway", state: "symptom" },
  { id: "orders", x: 175, y: 55, label: "orders", state: "symptom" },
  { id: "users", x: 175, y: 185, label: "users", state: "ok" },
  { id: "pay", x: 295, y: 55, label: "payments", state: "root" },
  { id: "notify", x: 295, y: 185, label: "notify", state: "ok" },
  { id: "db", x: 400, y: 120, label: "postgres", state: "ok" },
] as const;
const edges = [
  ["gw", "orders"],
  ["gw", "users"],
  ["orders", "pay"],
  ["users", "notify"],
  ["pay", "db"],
  ["notify", "db"],
  ["orders", "notify"],
] as const;
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const color = { root: "#f87171", symptom: "#fbbf24", ok: "#32cfce" } as const;
---

<section id="research" class="section" aria-labelledby="research-title">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-[2rem] border border-white/8 bg-gradient-to-br from-ink-800 via-ink-850 to-ink-950 p-6 sm:p-10 lg:p-12"
      data-reveal
    >
      <div class="grid-background pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow">{r.badge}</p>
            <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/25 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-200">
              <Microscope size={13} aria-hidden="true" />
              {r.status}
            </span>
          </div>
          <h2 id="research-title" class="heading-2">{r.title}</h2>
          <p class="lead">{r.description}</p>

          <h3 class="mt-8 font-mono text-xs tracking-[0.2em] text-slate-500 uppercase">{r.topicsTitle}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {r.topics.map((topic) => <li class="chip text-[0.8rem] text-slate-300">{topic}</li>)}
          </ul>

          <p class="mt-7 flex items-start gap-3 text-sm leading-6 text-slate-400">
            <Database size={17} class="mt-0.5 shrink-0 text-brand-300" aria-hidden="true" />
            {r.dataset}
          </p>
        </div>

        <figure class="rounded-[1.5rem] border border-white/8 bg-ink-950/70 p-4 sm:p-6" aria-hidden="true">
          <svg viewBox="0 0 460 240" class="h-auto w-full" role="presentation">
            <defs>
              <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0L10 5L0 10z" fill="#475569"></path>
              </marker>
            </defs>
            {
              edges.map(([from, to]) => {
                const a = byId[from];
                const b = byId[to];
                const hot = a.state !== "ok" && b.state !== "ok";
                return (
                  <line
                    x1={a.x + 26}
                    y1={a.y}
                    x2={b.x - 30}
                    y2={b.y}
                    stroke={hot ? "#fbbf24" : "#334155"}
                    stroke-opacity={hot ? 0.7 : 1}
                    stroke-width={hot ? 2 : 1.5}
                    stroke-dasharray={hot ? "5 4" : undefined}
                    marker-end="url(#arrow)"
                  />
                );
              })
            }
            {
              nodes.map((node) => (
                <g>
                  {node.state === "root" && (
                    <circle cx={node.x} cy={node.y} r="26" fill={color.root} opacity="0.25">
                      <animate attributeName="r" values="22;34;22" dur="2.4s" repeatCount="indefinite" />
                      <animate attributeName="opacity" values=".35;0;.35" dur="2.4s" repeatCount="indefinite" />
                    </circle>
                  )}
                  <circle cx={node.x} cy={node.y} r="22" fill="#0b111f" stroke={color[node.state]} stroke-width="2" />
                  <circle cx={node.x} cy={node.y} r="5" fill={color[node.state]} />
                  <text x={node.x} y={node.y + 40} text-anchor="middle" font-size="11" font-family="monospace" fill="#94a3b8">
                    {node.label}
                  </text>
                </g>
              ))
            }
          </svg>
          <figcaption class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-2 font-mono text-[0.7rem] text-slate-500">
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-red-400"></span>root cause</span>
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-amber-400"></span>symptom</span>
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-brand-400"></span>healthy</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
