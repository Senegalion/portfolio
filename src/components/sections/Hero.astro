---
import { ArrowDown, ArrowUpRight, Download } from "lucide-astro";
import { hasCv } from "../../data/build";
import { SITE } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const h = t.hero;

const companies = ["ING Bank Śląski", "Fair Place Finance", "Firmao", "Giganci Programowania", "Politechnika Łódzka", "Metropolia Helsinki"];

// Circular label around the scroll button.
const ring = h.badge;
---

<section id="top" class="relative isolate flex min-h-svh flex-col overflow-hidden pt-18">
  <div class="container-page flex flex-1 flex-col justify-center py-10 sm:py-12">
    <p class="fade-in flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted" style="--d:100ms">
      <span class="inline-flex items-center gap-2.5">
        <span class="status-dot" aria-hidden="true"></span>
        {h.availability}
      </span>
      <span class="text-line-strong" aria-hidden="true">—</span>
      <span>{h.location}</span>
    </p>

    <div class="mt-6 flex items-end justify-between gap-10 sm:mt-8">
      <h1 class="display text-[clamp(4rem,min(20vw,21vh),11.5rem)] text-fg">
        <span class="rise"><span style="--d:150ms">Łukasz</span></span>
        <span class="rise"><span style="--d:260ms" class="italic sm:pl-[0.9em]">Pelikan<span class="not-italic text-accent">.</span></span></span>
      </h1>

      <a
        href="#intro"
        class="fade-in group relative mb-4 hidden size-40 shrink-0 place-items-center text-fg lg:grid"
        style="--d:800ms"
        aria-label={h.scroll}
      >
        <svg viewBox="0 0 200 200" class="spin-slow absolute inset-0 size-full" aria-hidden="true">
          <defs>
            <path id="hero-ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
          </defs>
          <text class="fill-muted text-[13.5px] font-medium tracking-[0.18em] uppercase">
            <textPath href="#hero-ring" textLength="488">{ring}</textPath>
          </text>
        </svg>
        <span
          class="grid size-16 place-items-center rounded-full bg-accent text-on-accent transition-transform duration-500 group-hover:scale-110"
        >
          <ArrowDown size={24} aria-hidden="true" class="transition-transform duration-500 group-hover:translate-y-1" />
        </span>
      </a>
    </div>

    <div class="mt-8 grid items-end gap-8 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
      <div class="max-w-2xl">
        <p class="fade-in text-[clamp(1.2rem,2.2vw,1.5rem)] leading-[1.45] text-pretty text-fg" style="--d:450ms">
          {h.lead}
        </p>

        <p class="fade-in mt-5 flex flex-wrap items-baseline gap-x-2 text-base text-muted" style="--d:550ms">
          <span>{h.currentLabel}:</span>
          <span class="font-semibold text-fg">{h.currentRole}</span>
          <span>·</span>
          <span class="font-semibold text-fg">{h.currentCompany}</span>
        </p>
      </div>

      <div class="fade-in flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:justify-end" style="--d:650ms">
        <a href="#contact" class="btn btn-primary group">
          {h.primary}
          <ArrowUpRight size={18} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
        </a>
        <a href="#projects" class="btn btn-secondary group">
          {h.secondary}
          <ArrowDown size={17} class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true" />
        </a>
        {
          hasCv && (
            <a href={SITE.cvPath} download class="btn btn-secondary">
              <Download size={17} aria-hidden="true" />
              {h.cv}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="fade-in border-t border-line py-6" style="--d:900ms">
    <div class="container-page flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
      <p class="shrink-0 text-sm text-subtle">{h.trustedLabel}</p>
      <div class="marquee min-w-0 flex-1 overflow-hidden">
        <div class="marquee-track" style="--marquee-duration:45s">
          {
            [0, 1].map((copy) => (
              <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? "true" : undefined}>
                {companies.map((name) => (
                  <li class="flex items-center font-display text-2xl whitespace-nowrap text-fg sm:text-[1.7rem]">
                    <span class="px-6">{name}</span>
                    <span class="text-accent" aria-hidden="true">✦</span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
