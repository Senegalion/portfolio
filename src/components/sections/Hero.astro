---
import { ArrowDown, ArrowUpRight, Download } from "lucide-astro";
import { hasCv } from "../../data/build";
import { SITE, pagePath } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const h = t.hero;
---

<!-- Full-screen hero: muted looping video (stock footage, Pexels licence) under a dark shade. -->
<section id="top" class="force-dark relative isolate flex min-h-svh flex-col overflow-hidden bg-bg">
  <video
    data-hero-video
    class="hero-video absolute inset-0 -z-20 size-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  >
  </video>
  <script is:inline>
    // Runs during parsing: pick the poster for this screen right away, so a phone never
    // downloads (and flashes) the landscape frame first.
    (function () {
      var v = document.querySelector("[data-hero-video]");
      var portrait = window.matchMedia("(max-aspect-ratio: 1/1)").matches;
      v.poster = portrait ? "/media/hero-poster-portrait.webp" : "/media/hero-poster.webp";
      if (portrait) v.setAttribute("data-portrait", "");
    })();
  </script>
  <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="hero-content container-page flex flex-1 flex-col justify-center pt-28 pb-16 sm:pt-32">
    <p class="fade-in flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.8125rem] text-muted" style="--d:100ms">
      <span class="inline-flex items-center gap-2">
        <span class="status-dot" aria-hidden="true"></span>
        {h.availability}
      </span>
      <span aria-hidden="true">/</span>
      <span>{h.location}</span>
    </p>

    <h1 class="display mt-6 text-[clamp(3.25rem,10vw,7.5rem)] text-fg sm:mt-8">
      <span class="rise"><span style="--d:150ms">Łukasz</span></span>
      <span class="rise"><span style="--d:260ms">Pelikan</span></span>
    </h1>

    <p class="fade-in mt-6 text-[clamp(1.2rem,2.3vw,1.7rem)] leading-snug font-medium tracking-tight text-fg" style="--d:360ms">
      <span class="sr-only">{h.rotatorPrefix} {h.rotator.join(", ")}.</span>
      <span aria-hidden="true" class="inline-flex flex-wrap items-baseline gap-x-2">
        <span class="text-muted">{h.rotatorPrefix}</span>
        <span class="rotator" data-rotator>
          {h.rotator.map((phrase, index) => <span class:list={["rotator-item", index === 0 && "is-active"]}>{phrase}</span>)}
        </span>
      </span>
    </p>

    <p class="fade-in mt-5 max-w-2xl text-[clamp(1.125rem,1.8vw,1.35rem)] leading-[1.6] text-pretty text-fg/85" style="--d:400ms">
      {h.lead}
    </p>

    <p class="fade-in mt-5 flex flex-wrap items-baseline gap-x-2 text-base text-muted" style="--d:480ms">
      <span>{h.currentLabel}:</span>
      <span class="font-semibold text-fg">{h.currentRole}</span>
      <span>·</span>
      <span class="font-semibold text-fg">{h.currentCompany}</span>
    </p>

    <div class="fade-in mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:560ms">
      <a href={pagePath("contact", lang)} class="btn btn-primary">
        {h.primary}
        <ArrowUpRight size={17} aria-hidden="true" />
      </a>
      <a href={pagePath("projects", lang)} class="btn btn-secondary backdrop-blur-sm">
        {h.secondary}
        <ArrowUpRight size={17} aria-hidden="true" />
      </a>
      {
        hasCv && (
          <a href={SITE.cvPath} download class="btn btn-secondary backdrop-blur-sm">
            <Download size={16} aria-hidden="true" />
            {h.cv}
          </a>
        )
      }
    </div>
  </div>

  <a
    href="#logos"
    class="fade-in absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs text-muted transition hover:text-fg sm:flex"
    style="--d:900ms"
  >
    {t.home.scroll}
    <ArrowDown size={18} class="animate-bounce" aria-hidden="true" />
  </a>
</section>

<style>
  .hero-shade {
    background:
      linear-gradient(to right, rgb(8 11 16 / 0.88) 0%, rgb(8 11 16 / 0.62) 50%, rgb(8 11 16 / 0.35) 100%),
      linear-gradient(to top, rgb(8 11 16 / 0.9) 0%, transparent 40%);
  }

  /* Rotating specialisation: all phrases share one grid cell, so the line keeps the width
     of the longest phrase and nothing around it jumps when the text changes. */
  .rotator {
    display: inline-grid;
    color: var(--accent);
  }

  .rotator-item {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.55em);
    transition:
      opacity 0.45s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rotator-item.is-active {
    opacity: 1;
    transform: none;
  }

  .rotator-item.is-leaving {
    opacity: 0;
    transform: translateY(-0.55em);
  }

  @media (max-width: 420px) {
    .rotator-item {
      white-space: normal;
    }
  }

  /* Portrait screens (phones): a vertical crop of the clip is used, so the shade is
     lighter at the top to let the footage show and darker only where the text sits. */
  @media (max-aspect-ratio: 1/1) {
    .hero-video {
      /* Until the portrait poster/clip is set, keep the sharp right-hand part of the landscape frame. */
      object-position: 76% 50%;
    }

    .hero-shade {
      background: linear-gradient(
        to bottom,
        rgb(8 11 16 / 0.35) 0%,
        rgb(8 11 16 / 0.12) 22%,
        rgb(8 11 16 / 0.55) 42%,
        rgb(8 11 16 / 0.88) 62%,
        rgb(8 11 16 / 0.95) 100%
      );
    }

    /* Text at the bottom, the footage visible above it. */
    .hero-content {
      justify-content: flex-end;
      padding-bottom: 3rem;
    }

    .hero-video[data-portrait] {
      object-position: 50% 50%;
    }
  }
</style>

<script>
  // Cycle the specialisation phrases (not with reduced motion, and only while the hero is on screen).
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");
  if (rotator && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const items = [...rotator.children] as HTMLElement[];
    let current = 0;
    let onScreen = true;
    new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting)).observe(rotator);
    window.setInterval(() => {
      if (!onScreen || document.hidden) return;
      const previous = items[current];
      current = (current + 1) % items.length;
      previous.classList.remove("is-active");
      previous.classList.add("is-leaving");
      items[current].classList.remove("is-leaving");
      items[current].classList.add("is-active");
      window.setTimeout(() => previous.classList.remove("is-leaving"), 650);
    }, 2600);
  }

  // The clip is decoration, so it never competes with the page itself: it starts
  // downloading only after everything else has loaded, and not at all on slow
  // connections, with data saver or with reduced motion (the poster frame stays).
  // Portrait phones get a vertical crop, larger landscape screens 720p, small ones 540p.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");

  type NetInfo = { saveData?: boolean; effectiveType?: string };

  if (video) {
    const portraitQuery = window.matchMedia("(max-aspect-ratio: 1/1)");
    const connection = (navigator as Navigator & { connection?: NetInfo }).connection;
    const slow = Boolean(connection?.saveData) || /(^|-)2g$|^3g$/.test(connection?.effectiveType ?? "");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches || slow;
    let visible = true;
    let started = false;

    const choose = () =>
      portraitQuery.matches
        ? { src: "/media/hero-portrait.mp4", poster: "/media/hero-poster-portrait.webp", portrait: true }
        : {
            src: window.innerWidth >= 768 ? "/media/hero-720.mp4" : "/media/hero-540.mp4",
            poster: "/media/hero-poster.webp",
            portrait: false,
          };

    const apply = () => {
      const { src, poster, portrait } = choose();
      if (!video.poster.endsWith(poster)) video.poster = poster;
      video.toggleAttribute("data-portrait", portrait);
      if (still || !started || video.getAttribute("src") === src) return;
      video.src = src;
      if (visible) video.play().catch(() => {});
    };

    const start = () => {
      started = true;
      apply();
    };

    apply();
    portraitQuery.addEventListener("change", apply);

    if (!still) {
      if (document.readyState === "complete") start();
      else window.addEventListener("load", start, { once: true });

      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (!started) return;
        if (visible) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }
</script>
