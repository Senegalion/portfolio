---
import { ArrowUpRight } from "lucide-astro";
import Section from "../ui/Section.astro";
import { pagePath } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const a = t.about;

const [first, ...rest] = a.paragraphs;
---

<Section id="about" index={a.index} label={a.badge} title={a.title}>
  <div class="mt-14 grid gap-14 xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-20">
    <div class="max-w-2xl">
      <p class="text-xl leading-9 text-pretty text-fg sm:text-[1.375rem]" data-reveal>{first}</p>
      <div class="mt-6 space-y-5 text-lg leading-8 text-pretty text-muted" data-reveal>
        {rest.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <a href={pagePath("contact", lang)} class="group mt-10 inline-flex items-center gap-2 text-lg font-semibold text-fg" data-reveal>
        <span class="link">{a.contact}</span>
        <ArrowUpRight size={20} class="text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
    </div>

    <aside class="space-y-10">
      <dl class="grid grid-cols-2 gap-x-6 xl:grid-cols-1">
        {
          a.facts.map(({ value, label }, index) => (
            <div class="flex flex-col border-t border-line py-5" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="order-last mt-2 text-sm leading-6 text-muted">{label}</dt>
              <dd class="font-display text-4xl leading-none text-fg tabular-nums" data-count>{value}</dd>
            </div>
          ))
        }
      </dl>

      <div data-reveal>
        <h3 class="text-sm font-semibold text-fg">{a.languagesTitle}</h3>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {
            a.languages.map(({ name, level }) => (
              <li class="flex items-baseline justify-between gap-4 py-3 text-sm">
                <span class="text-fg">{name}</span>
                <span class="text-muted">{level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</Section>
