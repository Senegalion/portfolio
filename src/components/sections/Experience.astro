---
import { ArrowDown, ArrowUpRight, BriefcaseBusiness, Building2, Code2, GraduationCap, Network } from "lucide-astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechChip from "../ui/TechChip.astro";
import { SITE, formatPeriod } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const e = t.experience;
const c = e.companies;
const country = lang === "pl" ? "Polska" : "Poland";
const period = (from: string, to: string | null) => formatPeriod(from, to, lang, e.present);

type WorkMode = keyof typeof e.workModes;

const experience: {
  company: string;
  from: string;
  to: string | null;
  location: string;
  mode?: WorkMode;
  icon: typeof Building2;
  description: string;
  roles: { title: string; from: string; to: string | null; responsibilities: string[] }[];
  technologies: string[];
}[] = [
  {
    company: "ING Bank Śląski",
    from: "2025-09",
    to: null,
    location: c.ing.location,
    mode: "hybrid",
    icon: Building2,
    description: c.ing.description,
    roles: [
      { ...c.ing.roles.devops, from: "2026-03", to: null },
      { ...c.ing.roles.intern, from: "2025-09", to: "2026-02" },
    ],
    technologies: ["Java", "Spring Boot", "Azure", "Azure DevOps", "Apache Kafka", "Oracle Database", "Checkmarx", "JUnit 5", "Selenide", "REST Assured", "Kibana"],
  },
  {
    company: "Fair Place Finance SA",
    from: "2025-10",
    to: "2026-02",
    location: c.fairPlace.location,
    mode: "remote",
    icon: Network,
    description: c.fairPlace.description,
    roles: [{ ...c.fairPlace.roles.backend, from: "2025-10", to: "2026-02" }],
    technologies: ["Java 21", "Spring Boot", "GraphQL", "Kafka", "PostgreSQL", "Liquibase", "Docker", "Kubernetes", "Argo CD", "GitLab CI/CD", "Gradle"],
  },
  {
    company: "Firmao",
    from: "2025-05",
    to: "2025-08",
    location: c.firmao.location,
    mode: "onsite",
    icon: Code2,
    description: c.firmao.description,
    roles: [{ ...c.firmao.roles.fullstack, from: "2025-05", to: "2025-08" }],
    technologies: ["Java", "Hibernate", "PostgreSQL", "Ext JS", "Jenkins", "Selenium", "JasperReports"],
  },
  {
    company: "Giganci Programowania",
    from: "2024-02",
    to: "2025-04",
    location: c.giganci.location,
    icon: GraduationCap,
    description: c.giganci.description,
    roles: [{ ...c.giganci.roles.instructor, from: "2024-02", to: "2025-04" }],
    technologies: ["Python", "C++", "C#", "Algorithms", "Mentoring"],
  },
];
---

<section id="experience" class="section isolate overflow-hidden" aria-labelledby="experience-title">
  <div class="pointer-events-none absolute top-1/4 right-0 -z-10 size-[30rem] glow" aria-hidden="true"></div>

  <div class="container-page">
    <SectionHeading eyebrow={e.badge} title={e.title} description={e.description} id="experience-title" />

    <div class="relative mt-16">
    <div
      class="absolute top-0 bottom-0 left-[1.45rem] hidden w-px bg-gradient-to-b from-brand-400/50 via-white/10 to-transparent sm:block"
      aria-hidden="true"
    >
    </div>
    <ol class="relative space-y-6">

      {
        experience.map(({ company, from, to, location, mode, icon: Icon, description, roles, technologies }) => {
          const current = to === null;
          return (
            <li class="group relative sm:pl-20" data-reveal>
              <div
                class:list={[
                  "absolute top-8 left-0 z-10 hidden size-12 place-items-center rounded-2xl border bg-ink-850 transition sm:grid",
                  current
                    ? "border-brand-400/40 text-brand-300 shadow-lg shadow-brand-500/10"
                    : "border-white/10 text-slate-500 group-hover:border-brand-400/25 group-hover:text-brand-300",
                ]}
                aria-hidden="true"
              >
                <Icon size={20} />
              </div>

              <article class="spotlight rounded-[2rem] border border-white/8 bg-ink-850/80 p-6 transition duration-300 hover:border-white/15 sm:p-8 lg:p-10">
                <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="font-mono text-sm text-brand-300">{period(from, to)}</span>
                      {current && (
                        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/5 px-3 py-1 text-xs font-semibold text-emerald-300">
                          <span class="pulse-dot size-1.5 rounded-full bg-emerald-400" />
                          {e.currentCompany}
                        </span>
                      )}
                    </div>

                    <h3 class="mt-5 text-2xl font-bold tracking-tight text-white">{company}</h3>
                    <p class="mt-2 text-sm text-slate-400">
                      {location}, {country}
                      {mode && ` · ${e.workModes[mode]}`}
                    </p>
                    <p class="mt-6 text-sm leading-7 text-slate-400">{description}</p>

                    <ul class="mt-7 flex flex-wrap gap-2">
                      {technologies.map((technology) => (
                        <li>
                          <TechChip name={technology} />
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="space-y-8">
                    {roles.map((role, roleIndex) => (
                      <div class:list={["relative", roleIndex > 0 && "border-t border-white/8 pt-8"]}>
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                          <div>
                            <div class="flex flex-wrap items-center gap-3">
                              <h4 class="text-xl font-semibold text-white">{role.title}</h4>
                              {role.to === null && (
                                <span class="rounded-full border border-brand-400/20 bg-brand-400/5 px-2.5 py-1 text-[0.7rem] font-semibold tracking-wide text-brand-300 uppercase">
                                  {e.currentRole}
                                </span>
                              )}
                            </div>
                            <p class="mt-2 font-mono text-sm text-slate-500">{period(role.from, role.to)}</p>
                          </div>

                          {roleIndex === 0 && roles.length > 1 && (
                            <p class="hidden items-center gap-2 text-xs font-medium text-brand-300 sm:flex">
                              {e.careerProgression}
                              <ArrowDown size={15} aria-hidden="true" />
                            </p>
                          )}
                        </div>

                        <ul class="mt-6 space-y-3">
                          {role.responsibilities.map((responsibility) => (
                            <li class="flex gap-3 text-sm leading-7 text-slate-400">
                              <span class="mt-[0.65rem] size-1.5 shrink-0 rounded-full bg-brand-400" aria-hidden="true" />
                              <span>{responsibility}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
    </div>

    <div
      class="mt-12 flex flex-col gap-5 rounded-[1.75rem] border border-brand-400/15 bg-brand-400/[0.04] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      data-reveal
    >
      <div class="flex items-start gap-4">
        <div class="grid size-11 shrink-0 place-items-center rounded-2xl border border-brand-400/20 bg-brand-400/10 text-brand-300">
          <BriefcaseBusiness size={20} aria-hidden="true" />
        </div>
        <div>
          <p class="font-semibold text-white">{e.ctaTitle}</p>
          <p class="mt-1 text-sm leading-6 text-slate-400">{e.ctaDescription}</p>
        </div>
      </div>

      <a href={`mailto:${SITE.email}`} class="btn btn-primary group shrink-0">
        {e.contact}
        <ArrowUpRight size={17} class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
