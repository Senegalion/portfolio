---
import { ArrowUp, Plus } from "lucide-astro";
import Section from "../ui/Section.astro";
import LogoTile from "../ui/LogoTile.astro";
import TechChip from "../ui/TechChip.astro";
import type { OrgKey } from "../../data/orgs";
import { formatMonth, formatPeriod } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const e = t.experience;
const c = e.companies;
const period = (from: string, to: string | null) => formatPeriod(from, to, lang, e.present);

type WorkMode = keyof typeof e.workModes;

const experience: {
  org: OrgKey;
  company: string;
  from: string;
  to: string | null;
  location: string;
  industry: string;
  mode?: WorkMode;
  summary: string;
  roles: { title: string; from: string; to: string | null; responsibilities: string[] }[];
  technologies: string[];
}[] = [
  {
    org: "ing",
    company: "ING Bank Śląski",
    from: "2025-09",
    to: null,
    ...c.ing,
    mode: "hybrid",
    roles: [
      { ...c.ing.roles.devops, from: "2026-03", to: null },
      { ...c.ing.roles.intern, from: "2025-09", to: "2026-02" },
    ],
    technologies: ["Java", "Spring Boot", "Azure", "Azure DevOps", "Apache Kafka", "Oracle Database", "Checkmarx", "JUnit 5", "Selenide", "REST Assured", "Kibana"],
  },
  {
    org: "fairPlace",
    company: "Fair Place Finance",
    from: "2025-10",
    to: "2026-02",
    ...c.fairPlace,
    mode: "remote",
    roles: [{ ...c.fairPlace.roles.backend, from: "2025-10", to: "2026-02" }],
    technologies: ["Java 21", "Spring Boot", "GraphQL", "Kafka", "PostgreSQL", "Liquibase", "Docker", "Kubernetes", "Argo CD", "GitLab CI/CD", "Gradle"],
  },
  {
    org: "firmao",
    company: "Firmao",
    from: "2025-05",
    to: "2025-08",
    ...c.firmao,
    mode: "onsite",
    roles: [{ ...c.firmao.roles.fullstack, from: "2025-05", to: "2025-08" }],
    technologies: ["Java", "Hibernate", "PostgreSQL", "Ext JS", "Jenkins", "Selenium", "JasperReports"],
  },
  {
    org: "giganci",
    company: "Giganci Programowania",
    from: "2024-02",
    to: "2025-04",
    ...c.giganci,
    roles: [{ ...c.giganci.roles.instructor, from: "2024-02", to: "2025-04" }],
    technologies: ["Python", "C++", "C#", "Algorithms", "Mentoring"],
  },
];
---

<Section id="experience" index={e.index} label={e.badge} title={e.title} description={e.description}>
  <ol class="mt-16 border-b border-line">
    {
      experience.map(({ org, company, from, to, location, industry, mode, summary, roles, technologies }) => {
        const current = to === null;
        return (
          <li class="group grid gap-6 border-t border-line py-10 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10 lg:py-12" data-reveal>
            <div class="flex flex-row flex-wrap items-baseline gap-x-4 gap-y-1 md:flex-col md:gap-2">
              <LogoTile org={org} link class="mb-3 h-16 w-full max-w-44 basis-full md:basis-auto" />
              <p class="text-sm font-semibold text-fg tabular-nums">
                {formatMonth(from, lang, e.present)} — {formatMonth(to, lang, e.present)}
              </p>
              {current && (
                <p class="inline-flex items-center gap-2 text-sm text-ok">
                  <span class="status-dot" aria-hidden="true" />
                  {e.currentCompany}
                </p>
              )}
              <p class="text-sm text-subtle">
                {location}
                {mode && ` · ${e.workModes[mode]}`}
              </p>
            </div>

            <div class="min-w-0">
              <p class="text-sm font-medium text-accent">{industry}</p>
              <h3 class="mt-2 font-display text-[clamp(1.75rem,3.5vw,2.375rem)] leading-tight text-fg transition-transform duration-500 group-hover:translate-x-1">
                {company}
              </h3>

              <ul class="mt-5 flex flex-col gap-1.5">
                {roles.map((role, index) => (
                  <li class:list={["flex flex-wrap items-center gap-x-3 gap-y-1", index === 0 ? "text-lg font-semibold text-fg" : "text-base text-muted"]}>
                    {role.title}
                    {roles.length > 1 && (
                      <span class="text-sm font-normal text-subtle tabular-nums">{period(role.from, role.to)}</span>
                    )}
                    {roles.length > 1 && index === 0 && (
                      <span class="inline-flex items-center gap-1 rounded-md border border-line-strong px-2 py-0.5 text-xs font-medium text-muted">
                        <ArrowUp size={12} aria-hidden="true" />
                        {e.promotion}
                      </span>
                    )}
                  </li>
                ))}
              </ul>

              <p class="mt-5 max-w-2xl text-lg leading-8 text-pretty text-muted">{summary}</p>

              <details class="disclosure mt-7">
                <summary>
                  <span class="disclosure-icon">
                    <Plus size={14} aria-hidden="true" />
                  </span>
                  {e.details}
                </summary>
                <div class="disclosure-body mt-6 space-y-8 rounded-xl border border-line bg-surface p-6 sm:p-7">
                  {roles.map((role) => (
                    <div>
                      {roles.length > 1 && <h4 class="mb-3 text-sm font-semibold text-fg">{role.title}</h4>}
                      <ul class="space-y-2.5">
                        {role.responsibilities.map((item) => (
                          <li class="flex gap-3 text-[0.95rem] leading-7 text-muted">
                            <span class="mt-[0.7rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <div>
                    <h4 class="sr-only">{e.technologies}</h4>
                    <ul class="flex flex-wrap gap-2 border-t border-line pt-6">
                      {technologies.map((technology) => (
                        <li>
                          <TechChip name={technology} />
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
