---
import {
  ArrowDown,
  ArrowUpRight,
  BriefcaseBusiness,
  Building2,
  Code2,
  GraduationCap,
  Network,
} from 'lucide-astro';

import { getTranslations } from "../../i18n";

const lang = Astro.currentLocale === "en" ? "en" : "pl";
const t = getTranslations(lang);

const experience = [
  {
    company: 'ING Bank Śląski',
    companyPeriod: 'Sep 2025 — Present',
    location: 'Katowice, Poland · Hybrid',
    current: true,
    icon: Building2,
    description: t.experience.companies.ing.description,
    roles: [
      {
        period: 'Feb 2026 — Present',
        role: t.experience.companies.ing.roles.devops.title,
        current: true,
        responsibilities: [
          t.experience.companies.ing.roles.devops.responsibilities,
        ],
      },
      {
        period: 'Sep 2025 — Feb 2026',
        role: t.experience.companies.ing.roles.intern.title,
        current: false,
        responsibilities:
          t.experience.companies.ing.roles.intern.responsibilities,
      },
    ],
    technologies: [
      'Java',
      'Spring',
      'Oracle Database',
      'Apache Kafka',
      'Azure',
      'CI/CD',
      'Checkmarx',
      'DevOps',
    ],
  },
  {
    company: 'Fair Place Finance SA',
    companyPeriod: 'Oct 2025 — Feb 2026',
    location: 'Łódź, Poland · Remote',
    current: false,
    icon: Network,
    description: t.experience.companies.fairPlace.description,
    roles: [
      {
        period: 'Oct 2025 — Feb 2026',
        role: t.experience.companies.fairPlace.roles.backend.title,
        current: false,
        responsibilities:
          t.experience.companies.fairPlace.roles.backend.responsibilities,
      },
    ],
    technologies: [
      'Java 21',
      'Spring Boot',
      'GraphQL',
      'Kafka',
      'PostgreSQL',
      'Liquibase',
      'Docker',
      'Kubernetes',
      'Argo CD',
    ],
  },
  {
    company: 'Firmao',
    companyPeriod: 'May 2025 — Aug 2025',
    location: 'Łódź, Poland · On-site',
    current: false,
    icon: Code2,
    description:
      t.experience.companies.firmao.description,
    roles: [
      {
        period: 'May 2025 — Aug 2025',
        role:
          t.experience.companies.firmao.roles.fullstack.title,
        current: false,
        responsibilities:
          t.experience.companies.firmao.roles.fullstack.responsibilities,
      },
    ],
    technologies: [
      'Java',
      'Hibernate',
      'PostgreSQL',
      'Ext JS',
      'Jenkins',
      'Selenium',
      'JasperReports',
    ],
  },
  {
    company: 'Giganci Programowania',
    companyPeriod: 'Feb 2024 — Apr 2025',
    location: 'Łódź, Poland',
    current: false,
    icon: GraduationCap,
    description:
      t.experience.companies.giganci.description,
    roles: [
      {
        period: 'Feb 2024 — Apr 2025',
        role:
          t.experience.companies.giganci.roles.instructor.title,
        current: false,
        responsibilities:
          t.experience.companies.giganci.roles.instructor.responsibilities,
      },
    ],
    technologies: [
      'Python',
      'C++',
      'C#',
      'Algorithms',
      'Teaching',
      'Mentoring',
    ],
  },
];
---

<section
  id="experience"
  class="relative isolate overflow-hidden py-14 sm:py-16"
>
  <div
    class="pointer-events-none absolute right-0 top-1/4 -z-10 size-[30rem] rounded-full bg-brand-500/5 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <div class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-300"
      >
        {t.experience.badge}
      </p>

      <h2
        class="mt-5 text-4xl font-bold tracking-[-0.035em] text-white sm:text-5xl"
      >
        {t.experience.title}
      </h2>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">
        {t.experience.description}
      </p>
    </div>

    <div class="relative mt-16">
      <div
        class="absolute bottom-0 left-[1.45rem] top-0 hidden w-px bg-gradient-to-b from-brand-400/50 via-white/10 to-transparent sm:block"
        aria-hidden="true"
      >
      </div>

      <div class="space-y-6">
        {
          experience.map(
            ({
              company,
              companyPeriod,
              location,
              current,
              icon: Icon,
              description,
              roles,
              technologies,
            }) => (
              <article class="group relative sm:pl-20">
                <div
                  class:list={[
                    'absolute left-0 top-8 z-10 hidden size-12 place-items-center rounded-2xl border bg-[#090e19] transition sm:grid',
                    current
                      ? 'border-brand-400/40 text-brand-300 shadow-lg shadow-brand-500/10'
                      : 'border-white/10 text-slate-500 group-hover:border-brand-400/25 group-hover:text-brand-300',
                  ]}
                >
                  <Icon size={20} aria-hidden="true" />
                </div>

                <div class="rounded-[2rem] border border-white/8 bg-[#090e19]/80 p-6 transition duration-300 hover:border-white/15 hover:bg-[#0b111f] sm:p-8 lg:p-10">
                  <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
                    <div>
                      <div class="flex flex-wrap items-center gap-3">
                        <span class="font-mono text-sm text-brand-300">
                          {companyPeriod}
                        </span>

                        {
                          current && (
                            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/5 px-3 py-1 text-xs font-semibold text-emerald-300">
                              <span class="size-1.5 rounded-full bg-emerald-400" />
                              {t.experience.currentCompany}
                            </span>
                          )
                        }
                      </div>

                      <h3 class="mt-5 text-2xl font-bold tracking-tight text-white">
                        {company}
                      </h3>

                      <p class="mt-2 text-sm text-slate-400">
                        {location}
                      </p>

                      <p class="mt-6 text-sm leading-7 text-slate-400">
                        {description}
                      </p>

                      <div class="mt-7 flex flex-wrap gap-2">
                        {
                          technologies.map((technology) => (
                            <span class="rounded-full border border-white/8 bg-white/[0.025] px-3 py-1.5 text-xs font-medium text-slate-400">
                              {technology}
                            </span>
                          ))
                        }
                      </div>
                    </div>

                    <div class="space-y-8">
                      {
                        roles.map((role, roleIndex) => (
                          <div
                            class:list={[
                              'relative',
                              roleIndex > 0 &&
                                'border-t border-white/8 pt-8',
                            ]}
                          >
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                              <div>
                                <div class="flex flex-wrap items-center gap-3">
                                  <h4 class="text-xl font-semibold text-white">
                                    {role.role}
                                  </h4>

                                  {
                                    role.current && (
                                      <span class="rounded-full border border-brand-400/20 bg-brand-400/5 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-brand-300">
                                        {t.experience.currentRole}
                                      </span>
                                    )
                                  }
                                </div>

                                <p class="mt-2 font-mono text-sm text-slate-500">
                                  {role.period}
                                </p>
                              </div>

                              {
                                roleIndex === 0 && roles.length > 1 && (
                                  <div class="hidden items-center gap-2 text-xs font-medium text-brand-300 sm:flex">
                                    {t.experience.careerProgression}
                                    <ArrowDown
                                      size={15}
                                      aria-hidden="true"
                                    />
                                  </div>
                                )
                              }
                            </div>

                            <ul class="mt-6 space-y-3">
                              {
                                role.responsibilities.map((responsibility) => (
                                  <li class="flex gap-3 text-sm leading-7 text-slate-400">
                                    <span
                                      class="mt-[0.65rem] size-1.5 shrink-0 rounded-full bg-brand-400"
                                      aria-hidden="true"
                                    />
                                    <span>{responsibility}</span>
                                  </li>
                                ))
                              }
                            </ul>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </article>
            ),
          )
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-5 rounded-[1.75rem] border border-brand-400/15 bg-brand-400/[0.04] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    >
      <div class="flex items-start gap-4">
        <div
          class="grid size-11 shrink-0 place-items-center rounded-2xl border border-brand-400/20 bg-brand-400/10 text-brand-300"
        >
          <BriefcaseBusiness size={20} aria-hidden="true" />
        </div>

        <div>
          <p class="font-semibold text-white">
            {t.experience.ctaTitle}
          </p>

          <p class="mt-1 text-sm leading-6 text-slate-400">
            {t.experience.ctaDescription}
          </p>
        </div>
      </div>

      <a
        href="https://mail.google.com/mail/?view=cm&fs=1&to=lupelikan@gmail.com"
        target="_blank"
        rel="noreferrer"
        class="group inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-white px-5 font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-brand-400"
      >
        {t.experience.contact}

        <ArrowUpRight
          size={17}
          class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</section>