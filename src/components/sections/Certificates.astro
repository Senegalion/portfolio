---
import { ChevronDown, Maximize2, X } from "lucide-astro";
import Section from "../ui/Section.astro";
import { CERTIFICATES, CERT_CATEGORIES, UPCOMING_CERTS, type Certificate } from "../../data/certificates";
import { formatMonth } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const c = t.certificates;

const newestFirst = (a: Certificate, b: Certificate) => b.date.localeCompare(a.date);
const featured = CERTIFICATES.filter((cert) => cert.featured);
const scans = CERTIFICATES.filter((cert) => cert.image && !cert.featured).sort(newestFirst);
const courses = CERTIFICATES.filter((cert) => !cert.image).sort(newestFirst);

const count = (category: string) =>
  CERTIFICATES.filter((cert) => !cert.featured && cert.category === category).length;
const meta = (cert: Certificate) => `${cert.issuer} · ${formatMonth(cert.date, lang, "")}`;
const full = (image: string) => `/certificates/${image}.webp`;
const thumb = (image: string) => `/certificates/${image}-thumb.webp`;

/** Cards shown before "show all" — keeps the page short, especially on phones. */
const VISIBLE = 6;

const statusTone = { preparing: "border-line-strong text-fg", planned: "border-line text-subtle" } as const;
---

<Section id="certificates" index={c.index} label={c.badge} title={c.title} description={c.description}>
  <p class="mt-8 font-mono text-sm text-subtle" data-reveal>
    <span class="text-fg">{CERTIFICATES.length}</span>{" "}{c.total}
  </p>

  <!-- Highlights: the certificates that matter most, shown large. -->
  <h3 class="sr-only">{c.featured}</h3>
  <ul class="mt-10 grid gap-5 md:grid-cols-2">
    {
      featured.map((cert, index) => (
        <li
          class="group flex flex-col overflow-hidden rounded-xl border border-line bg-bg transition-colors duration-500 hover:border-line-strong"
          data-reveal
          style={`--reveal-delay:${(index % 2) * 80}ms`}
        >
          <button
            type="button"
            class="relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden border-b border-line bg-surface p-5 sm:p-7"
            data-cert-open={full(cert.image!)}
            data-cert-title={cert.name}
          >
            <img
              src={thumb(cert.image!)}
              alt={cert.name}
              loading="lazy"
              decoding="async"
              class="size-full object-contain drop-shadow-xl transition duration-700 ease-out group-hover:scale-[1.03]"
            />
            <span class="absolute right-3 bottom-3 grid size-9 place-items-center rounded-lg bg-bg/85 text-fg opacity-0 shadow backdrop-blur transition group-hover:opacity-100 group-focus-within:opacity-100">
              <Maximize2 size={16} aria-hidden="true" />
              <span class="sr-only">{c.view}</span>
            </span>
          </button>
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <p class="text-sm font-medium text-accent">{c.categories[cert.category]}</p>
            <h4 class="mt-2 font-display text-[1.45rem] leading-tight text-balance text-fg">{cert.name}</h4>
            <p class="mt-1.5 text-sm text-subtle">{meta(cert)}</p>
            {cert.note && <p class="mt-4 leading-7 text-pretty text-muted">{cert.note[lang]}</p>}
            {cert.credentialId && (
              <p class="mt-auto pt-5 font-mono text-xs text-subtle">
                {c.credential}: {cert.credentialId}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <!-- Full list, filterable by area. -->
  <div class="mt-16 flex flex-wrap gap-2" role="group" aria-label={c.filterLabel} data-cert-filter data-reveal>
    <button type="button" data-value="all" aria-pressed="true" class="cert-chip">
      {c.all}
    </button>
    {
      CERT_CATEGORIES.map((category) => (
        <button type="button" data-value={category} aria-pressed="false" class="cert-chip">
          {c.categories[category]}
          <span class="tabular-nums opacity-60">{count(category)}</span>
        </button>
      ))
    }
  </div>

  <div id="cert-list">
    <section data-cert-group class="mt-10">
      <h3 class="text-sm font-semibold text-fg">{c.scans}</h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          scans.map((cert, index) => (
            <li data-cat={cert.category} data-extra={index >= VISIBLE ? "" : undefined} class="group flex flex-col overflow-hidden rounded-xl border border-line bg-bg transition-colors hover:border-line-strong">
              <button
                type="button"
                class="relative block aspect-[4/3] w-full cursor-zoom-in overflow-hidden border-b border-line bg-surface"
                data-cert-open={full(cert.image!)}
                data-cert-title={cert.name}
              >
                <img
                  src={thumb(cert.image!)}
                  alt={cert.name}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover object-top transition duration-700 ease-out group-hover:scale-105"
                />
                <span class="absolute right-3 bottom-3 grid size-8 place-items-center rounded-lg bg-bg/85 text-fg opacity-0 shadow backdrop-blur transition group-hover:opacity-100">
                  <Maximize2 size={14} aria-hidden="true" />
                  <span class="sr-only">{c.view}</span>
                </span>
              </button>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-medium text-accent">{c.categories[cert.category]}</p>
                <h4 class="mt-1.5 text-[1.05rem] leading-snug font-semibold text-fg">{cert.name}</h4>
                <p class="mt-1 text-sm text-subtle">{meta(cert)}</p>
                {cert.note && <p class="mt-3 text-[0.92rem] leading-6 text-pretty text-muted">{cert.note[lang]}</p>}
              </div>
            </li>
          ))
        }
      </ul>
      {scans.length > VISIBLE && (
        <button type="button" class="btn btn-secondary mt-6 w-full sm:w-auto" data-cert-more>
          {c.showAll} ({scans.length})
          <ChevronDown size={16} aria-hidden="true" />
        </button>
      )}
    </section>

    <section data-cert-group class="mt-14">
      <h3 class="text-sm font-semibold text-fg">{c.courses}</h3>
      <ul class="mt-4 border-b border-line">
        {
          courses.map((cert) => (
            <li data-cat={cert.category} class="grid gap-1 border-t border-line py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6">
              <div class="min-w-0">
                <p class="font-medium text-fg">{cert.name}</p>
                <p class="mt-0.5 text-sm text-subtle">
                  {meta(cert)}
                  {cert.credentialId && <span class="font-mono"> · {c.credential}: {cert.credentialId}</span>}
                </p>
              </div>
              <span class="text-sm text-muted sm:text-right">{c.categories[cert.category]}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <h3 class="mt-14 text-sm font-semibold text-fg" data-reveal>{c.upcoming}</h3>
  <ul class="mt-4 border-b border-line">
    {
      UPCOMING_CERTS.map((cert) => (
        <li class="flex flex-col gap-2 border-t border-line py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6" data-reveal>
          <div class="min-w-0">
            <p class="font-medium text-fg">{cert.name}</p>
            <p class="mt-0.5 text-sm text-subtle">{cert.issuer}</p>
          </div>
          <span class:list={["w-fit shrink-0 rounded-md border px-2.5 py-1 text-xs font-semibold", statusTone[cert.status]]}>
            {c.statuses[cert.status]}
          </span>
        </li>
      ))
    }
  </ul>

  <dialog id="cert-viewer" class="cert-viewer" aria-label={c.view}>
    <div class="flex max-h-[92vh] max-w-[min(92vw,72rem)] flex-col gap-3">
      <div class="flex items-center justify-between gap-4 text-white">
        <p class="truncate text-sm font-medium" data-cert-caption></p>
        <button type="button" class="grid size-10 shrink-0 place-items-center rounded-lg bg-white/10 transition hover:bg-white/20" data-cert-close>
          <X size={18} aria-hidden="true" />
          <span class="sr-only">{c.close}</span>
        </button>
      </div>
      <img alt="" class="max-h-[calc(92vh-3.5rem)] w-auto max-w-full rounded-lg bg-white object-contain shadow-2xl" data-cert-image />
    </div>
  </dialog>
</Section>

<style>
  .cert-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .cert-chip:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  .cert-chip[aria-pressed="true"] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  #cert-list:not([data-expanded]) [data-extra] {
    display: none;
  }

  #cert-list[data-expanded] [data-cert-more] {
    display: none;
  }

  .cert-viewer {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .cert-viewer::backdrop {
    background: rgb(5 8 12 / 0.85);
    backdrop-filter: blur(6px);
  }

  .cert-viewer[open] {
    animation: cert-in 0.25s ease-out;
  }

  @keyframes cert-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
</style>

<script>
  // Filter by area.
  const filter = document.querySelector<HTMLElement>("[data-cert-filter]");
  const list = document.getElementById("cert-list");

  filter?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-value]");
    if (!button || !list) return;
    const value = button.dataset.value;
    // A single area is short enough to show in full.
    if (value !== "all") list.setAttribute("data-expanded", "");
    filter.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
    list.querySelectorAll<HTMLElement>("[data-cert-group]").forEach((group) => {
      let visible = 0;
      group.querySelectorAll<HTMLElement>("[data-cat]").forEach((item) => {
        const show = value === "all" || item.dataset.cat === value;
        item.hidden = !show;
        if (show) visible++;
      });
      group.hidden = visible === 0;
    });
  });

  list?.querySelector("[data-cert-more]")?.addEventListener("click", () => list.setAttribute("data-expanded", ""));

  // Full-size viewer.
  const viewer = document.getElementById("cert-viewer") as HTMLDialogElement | null;
  const image = viewer?.querySelector<HTMLImageElement>("[data-cert-image]");
  const caption = viewer?.querySelector<HTMLElement>("[data-cert-caption]");

  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>("[data-cert-open]");
    if (!trigger || !viewer || !image || !caption) return;
    image.src = trigger.dataset.certOpen!;
    image.alt = trigger.dataset.certTitle ?? "";
    caption.textContent = trigger.dataset.certTitle ?? "";
    viewer.showModal();
  });

  viewer?.querySelector("[data-cert-close]")?.addEventListener("click", () => viewer.close());
  // Clicking the dimmed backdrop closes the viewer.
  viewer?.addEventListener("click", (event) => {
    if (event.target === viewer) viewer.close();
  });
</script>
