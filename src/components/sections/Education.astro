---
import Section from "../ui/Section.astro";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const ed = t.education;

type Status = keyof typeof ed.statuses;

const studies = [
  { ...ed.items.msc, school: ed.university, done: false },
  { ...ed.items.mbs, school: ed.university, done: false },
  { ...ed.items.beng, school: ed.university, done: true },
  { ...ed.items.erasmus, done: true },
];

const certs: { key: keyof typeof ed.certs; status: Status }[] = [
  { key: "az900", status: "passed" },
  { key: "elementsOfAi", status: "enrolled" },
  { key: "az204", status: "preparing" },
  { key: "oracle", status: "planned" },
];

const statusTone: Record<Status, string> = {
  passed: "border-ok/50 text-ok",
  enrolled: "border-line-strong text-fg",
  preparing: "border-line-strong text-muted",
  planned: "border-line text-subtle",
};
---

<Section id="education" index={ed.index} label={ed.badge} title={ed.title} description={ed.description}>
  <ol class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
    {
      studies.map(({ degree, school, detail, note, done }, index) => (
        <li class="flex flex-col bg-bg p-7 sm:p-8" data-reveal style={`--reveal-delay:${(index % 2) * 80}ms`}>
          <div class="flex items-center justify-between gap-4 text-sm">
            <span class="text-muted">{school}</span>
            <span class:list={["inline-flex items-center gap-2 font-medium", done ? "text-subtle" : "text-ok"]}>
              {!done && <span class="status-dot" aria-hidden="true" />}
              {done ? ed.completed : ed.inProgress}
            </span>
          </div>
          <h3 class="mt-8 font-display text-[2rem] leading-[1.05] text-balance text-fg">{degree}</h3>
          <p class="mt-4 leading-7 text-muted">{detail}</p>
          <p class="mt-auto pt-6 text-sm text-subtle">{note}</p>
        </li>
      ))
    }
  </ol>

  <h3 class="mt-16 text-sm font-semibold text-fg" data-reveal>{ed.certsTitle}</h3>
  <ul class="mt-4 border-b border-line">
    {
      certs.map(({ key, status }) => {
        const cert = ed.certs[key];
        return (
          <li class="flex flex-col gap-2 border-t border-line py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6" data-reveal>
            <div class="min-w-0">
              <p class="text-lg font-medium text-fg">{cert.name}</p>
              <p class="mt-0.5 text-sm text-subtle">
                {cert.issuer}
                {cert.date && ` · ${cert.date}`}
              </p>
            </div>
            <span class:list={["w-fit shrink-0 rounded-full border px-3 py-1 text-xs font-semibold", statusTone[status]]}>
              {ed.statuses[status]}
            </span>
          </li>
        );
      })
    }
  </ul>
</Section>
