---
import Section from "../ui/Section.astro";
import { SKILL_CATEGORIES, label } from "../../data/skills";
import { logoFor } from "../../data/tech";
import { getTranslations, langFrom } from "../../i18n";

const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const s = t.skills;
---

<Section id="skills" index={s.index} label={s.badge} title={s.title} description={s.description}>
  <div class="mt-12 flex flex-wrap items-center justify-between gap-4" data-reveal>
    <p class="inline-flex items-center gap-2.5 text-sm text-muted">
      <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
      {s.commercial}
    </p>
    <div class="inline-flex rounded-full border border-line-strong p-1" role="group" aria-label={s.filterLabel} data-skill-filter>
      <button
        type="button"
        data-value="all"
        aria-pressed="true"
        class="min-h-9 rounded-full px-4 text-sm font-medium text-muted transition hover:text-fg aria-pressed:bg-fg aria-pressed:text-bg"
      >
        {s.filterAll}
      </button>
      <button
        type="button"
        data-value="commercial"
        aria-pressed="false"
        class="min-h-9 rounded-full px-4 text-sm font-medium text-muted transition hover:text-fg aria-pressed:bg-fg aria-pressed:text-bg"
      >
        {s.filterCommercial}
      </button>
    </div>
  </div>

  <ul id="skill-grid" class="mt-8 border-b border-line">
    {
      SKILL_CATEGORIES.map((category) => (
        <li class="grid gap-4 border-t border-line py-6 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-8" data-category data-reveal>
          <h3 class="font-semibold text-fg">{category.title[lang]}</h3>
          <ul class="flex flex-wrap gap-2">
            {category.skills.map((skill) => {
              const name = label(skill.name, lang);
              const logo = logoFor(name);
              return (
                <li
                  data-commercial={skill.commercial ? "" : undefined}
                  class:list={["tag text-[0.82rem] transition-opacity", skill.commercial && "border-line-strong bg-surface text-fg"]}
                >
                  {logo && (
                    <img
                      src={logo.src}
                      alt=""
                      width="15"
                      height="15"
                      loading="lazy"
                      decoding="async"
                      class:list={["size-[15px] shrink-0 object-contain", logo.mono && "logo-mono"]}
                    />
                  )}
                  <span class="whitespace-normal">{name}</span>
                  {skill.commercial && (
                    <>
                      <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span class="sr-only">({s.commercialShort})</span>
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  const group = document.querySelector<HTMLElement>("[data-skill-filter]");
  const grid = document.getElementById("skill-grid");

  group?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-value]");
    if (!button || !grid) return;
    const onlyCommercial = button.dataset.value === "commercial";
    group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === button)));

    grid.querySelectorAll<HTMLElement>("[data-category]").forEach((category) => {
      let visible = 0;
      category.querySelectorAll<HTMLElement>("ul > li").forEach((chip) => {
        const show = !onlyCommercial || chip.hasAttribute("data-commercial");
        chip.hidden = !show;
        if (show) visible++;
      });
      category.hidden = visible === 0;
    });
  });
</script>
