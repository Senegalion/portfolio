---
import { ArrowUpRight, Plus } from "lucide-astro";
import ProjectFlow from "../ui/ProjectFlow.astro";
import Section from "../ui/Section.astro";
import TechChip from "../ui/TechChip.astro";
import { SITE } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const pt = t.projects;
const repo = (name: string) => `${SITE.github}/${name}`;

type Status = keyof typeof pt.status;
type ProjectKey = keyof typeof pt.projects;

const projects: {
  key: ProjectKey;
  title: string;
  status?: Status;
  technologies: string[];
  links: { label: string; href: string }[];
}[] = [
  {
    key: "karate",
    title: "Karate Management System",
    status: "thesis",
    technologies: ["Java", "Kotlin", "Spring Boot", "Spring Cloud", "Kafka", "RabbitMQ", "PostgreSQL", "Flyway", "Redis", "Docker", "Jenkins", "React", "PayPal API"],
    links: [{ label: pt.viewRepository, href: repo("KarateManagementSystem") }],
  },
  {
    key: "cityFailurePredictor",
    title: "City Failure Predictor",
    status: "team",
    technologies: ["Python", "Machine Learning", "Prometheus", "Grafana", "Loki", "Docker"],
    links: [{ label: pt.viewRepository, href: "https://github.com/Yehor-Kovalenko/CityFailurePredictor" }],
  },
  {
    key: "jobOffers",
    title: "Job Offers",
    technologies: ["Java", "Spring Boot", "MongoDB", "Redis", "React", "Docker", "AWS", "Testcontainers"],
    links: [
      { label: pt.viewRepository, href: repo("JobOffers") },
      { label: pt.frontendRepository, href: repo("JobOffersFrontend") },
    ],
  },
  {
    key: "traffic",
    title: "Traffic Light Predictor",
    status: "research",
    technologies: ["Java", "Spring Boot", "PostgreSQL", "PostGIS", "Python", "scikit-learn", "Kotlin"],
    links: [{ label: pt.viewRepository, href: repo("TrafficLightPredictor") }],
  },
  {
    key: "thousand",
    title: "Thousand Online",
    technologies: ["Java 25", "Spring Boot", "React", "TypeScript", "Tailwind CSS", "WebSocket"],
    links: [{ label: pt.viewRepository, href: repo("Thousand-Card-Game") }],
  },
  {
    key: "akigator",
    title: "Akigator",
    technologies: ["Java", "Spring Boot", "React", "TypeScript", "Python", "PostgreSQL", "Docker"],
    links: [{ label: pt.viewRepository, href: repo("AkigatorApp") }],
  },
  {
    key: "lotto",
    title: "Lotto Application",
    technologies: ["Java", "Spring Boot", "MongoDB", "Docker", "JUnit", "Mockito", "WireMock", "Testcontainers"],
    links: [{ label: pt.viewRepository, href: repo("LottoApplication") }],
  },
];

const more = [
  { name: "Convolutional_Neural_Network", text: pt.more.cnn },
  { name: "Fuzzy-Logic-Paddle-Controller-for-Pong-scikit-fuzzy-", text: pt.more.fuzzy },
  { name: "Pacman_Search_AI", text: pt.more.pacman },
  { name: "Multi-Agent_Search", text: pt.more.multiAgent },
];
---

<Section id="projects" index={pt.index} label={pt.badge} title={pt.title} description={pt.description}>
  <ol class="mt-16 border-b border-line">
    {
      projects.map(({ key, title, status, technologies, links }, index) => {
        const p = pt.projects[key];
        const featured = index === 0;
        return (
          <li class="group relative border-t border-line py-10 lg:py-12" data-reveal>
            <span
              class="absolute top-0 left-0 h-px w-0 bg-accent transition-[width] duration-700 ease-out group-hover:w-full"
              aria-hidden="true"
            />
            <div class="grid gap-x-8 gap-y-5 md:grid-cols-[3rem_minmax(0,1fr)]">
              <span class="pt-1 font-mono text-sm leading-none text-subtle tabular-nums transition-colors duration-500 group-hover:text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>

              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <p class="text-sm font-medium text-accent">{p.kind}</p>
                  {status && <span class="tag py-0.5 text-xs">{pt.status[status]}</span>}
                  {featured && <span class="tag border-accent/40 py-0.5 text-xs text-fg">{pt.featured}</span>}
                </div>

                <h3
                  class:list={[
                    "mt-3 font-display leading-[1.05] text-fg",
                    featured ? "text-[clamp(2rem,4.5vw,3rem)]" : "text-[clamp(1.6rem,3.2vw,2.25rem)]",
                  ]}
                >
                  {title}
                </h3>

                <p class:list={["mt-5 max-w-2xl leading-8 text-pretty text-muted", featured ? "text-xl" : "text-lg"]}>
                  {p.summary}
                </p>
                {p.note && <p class="mt-3 max-w-2xl text-sm leading-6 text-subtle">{p.note}</p>}

                <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
                  {links.map(({ label, href }) => (
                    <a href={href} target="_blank" rel="noreferrer" class="group/link inline-flex items-center gap-1.5 text-sm font-semibold text-fg">
                      <span class="link">{label}</span>
                      <span class="sr-only">— {title}</span>
                      <ArrowUpRight
                        size={16}
                        class="text-accent transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                        aria-hidden="true"
                      />
                    </a>
                  ))}
                </div>

                <details class="disclosure mt-6">
                  <summary>
                    <span class="disclosure-icon">
                      <Plus size={14} aria-hidden="true" />
                    </span>
                    {pt.details}
                  </summary>
                  <div class="disclosure-body mt-6 grid gap-6 rounded-xl border border-line bg-surface p-6 sm:p-7 xl:grid-cols-2 xl:gap-8">
                    <ProjectFlow flow={p.flow} label={pt.architecture} />
                    <div class="min-w-0">
                      <ul class="space-y-2.5">
                        {p.highlights.map((highlight) => (
                          <li class="flex gap-3 text-[0.95rem] leading-7 text-muted">
                            <span class="mt-[0.7rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                      <ul class="mt-6 flex flex-wrap gap-2 border-t border-line pt-6">
                        {technologies.map((technology) => (
                          <li>
                            <TechChip name={technology} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <div class="mt-16 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]" data-reveal>
    <div>
      <h3 class="font-display text-2xl text-fg">{pt.moreTitle}</h3>
      <p class="mt-2 text-muted">{pt.moreDescription}</p>
      <a
        href={SITE.githubRepositories}
        target="_blank"
        rel="noreferrer"
        class="group mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-fg"
      >
        <span class="link">{pt.viewRepositories}</span>
        <ArrowUpRight size={16} class="text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
      {
        more.map(({ name, text }) => (
          <li>
            <a
              href={repo(name)}
              target="_blank"
              rel="noreferrer"
              class="group flex h-full items-start justify-between gap-4 bg-bg p-5 transition-colors duration-300 hover:bg-surface"
            >
              <span class="min-w-0">
                <span class="block font-medium text-fg">{text}</span>
                <span class="mt-1 block truncate text-xs text-subtle">{name.replace(/[-_]+$/, "").replaceAll("_", " ")}</span>
              </span>
              <ArrowUpRight
                size={16}
                class="mt-1 shrink-0 text-subtle transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
