---
import { ORGS, type OrgKey } from "../../data/orgs";

interface Props {
  org: OrgKey;
  class?: string;
  /** Wrap the tile in a link to the organisation's website. */
  link?: boolean;
}

const { org, class: className, link = false } = Astro.props;
const { name, url, ...rest } = ORGS[org];
const logo = "logo" in rest ? rest.logo : undefined;
const mark = "mark" in rest ? rest.mark : undefined;
const dark = "dark" in rest && rest.dark;
const Tag = link ? "a" : "span";
---

<Tag
  class:list={["logo-tile", dark && "logo-tile--dark", link && "transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/10", className]}
  {...link ? { href: url, target: "_blank", rel: "noreferrer", title: name } : {}}
>
  {
    logo ? (
      <img src={logo} alt={name} loading="lazy" decoding="async" />
    ) : (
      <span class="logo-wordmark" role="img" aria-label={name}>{mark ?? name}</span>
    )
  }
</Tag>
