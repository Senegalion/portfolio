---
import { logoFor } from "../../data/tech";

interface Props {
  name: string;
  highlighted?: boolean;
  class?: string;
}

const { name, highlighted = false, class: className } = Astro.props;
const logo = logoFor(name);
---

<span
  class:list={[
    "chip",
    highlighted && "border-brand-400/25 bg-brand-400/[0.07] text-brand-100",
    className,
  ]}
>
  {
    logo && (
      <img
        src={logo.src}
        alt=""
        width="14"
        height="14"
        loading="lazy"
        decoding="async"
        class:list={["size-3.5 shrink-0 object-contain", logo.mono && "logo-mono"]}
      />
    )
  }
  {name}
  <slot />
</span>
