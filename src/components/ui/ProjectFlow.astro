---
import { ArrowDown, ArrowRight } from "lucide-astro";
import { logoFor } from "../../data/tech";

interface Props {
  flow: string[][];
  label: string;
}

const { flow, label } = Astro.props;
---

<!-- Data-driven flow diagram: vertical on phones, horizontal from sm. -->
<figure class="min-w-0" aria-label={label}>
  <figcaption class="mb-4 text-xs font-semibold text-subtle">{label}</figcaption>

  <ol class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-1.5">
    {
      flow.map((column, index) => (
        <>
          <li class="flex min-w-0 flex-1 flex-row flex-wrap justify-center gap-1.5 sm:flex-col">
            {column.map((node) => {
              const logo = logoFor(node);
              const edge = index === 0 || index === flow.length - 1;
              return (
                <span
                  class:list={[
                    "inline-flex min-w-0 items-center justify-center gap-1.5 rounded-lg border px-2 py-1.5 text-center text-[0.72rem] leading-tight font-medium",
                    edge ? "border-accent/50 text-fg" : "border-line-strong bg-bg text-muted",
                  ]}
                >
                  {logo && (
                    <img
                      src={logo.src}
                      alt=""
                      width="12"
                      height="12"
                      loading="lazy"
                      decoding="async"
                      class:list={["size-3 shrink-0", logo.mono && "logo-mono"]}
                    />
                  )}
                  <span class="min-w-0 break-words">{node}</span>
                </span>
              );
            })}
          </li>
          {index < flow.length - 1 && (
            <li aria-hidden="true" class="grid shrink-0 place-items-center text-accent">
              <ArrowDown size={13} class="sm:hidden" />
              <ArrowRight size={13} class="hidden sm:block" />
            </li>
          )}
        </>
      ))
    }
  </ol>
</figure>
