---
import { ChevronDown, ChevronRight } from "lucide-astro";
import { logoFor } from "../../data/tech";

interface Props {
  flow: string[][];
  label: string;
  compact?: boolean;
}

const { flow, label, compact = false } = Astro.props;
---

<!-- Data-driven architecture / data-flow diagram: vertical on phones, horizontal from sm. -->
<figure
  class="relative overflow-hidden rounded-[1.25rem] border border-white/8 bg-ink-950/70 p-4"
  aria-label={label}
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgb(50_207_206/8%),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <figcaption class="relative mb-3 font-mono text-[0.65rem] tracking-[0.2em] text-slate-500 uppercase">
    {label}
  </figcaption>

  <ol class="relative flex flex-col items-stretch gap-1.5 sm:flex-row sm:items-center sm:gap-1">
    {
      flow.map((column, index) => (
        <>
          <li class="flex min-w-0 flex-1 flex-row flex-wrap justify-center gap-1.5 sm:flex-col">
            {column.map((node) => {
              const logo = logoFor(node);
              return (
                <span
                  class:list={[
                    "inline-flex min-w-0 items-center justify-center gap-1.5 rounded-lg border px-2 py-1.5 text-center font-mono leading-tight",
                    compact ? "text-[0.65rem]" : "text-[0.7rem]",
                    index === 0 || index === flow.length - 1
                      ? "border-brand-400/25 bg-brand-400/[0.07] text-brand-100"
                      : "border-white/10 bg-white/[0.03] text-slate-300",
                  ]}
                >
                  {logo && (
                    <img
                      src={logo.src}
                      alt=""
                      width="12"
                      height="12"
                      loading="lazy"
                      decoding="async"
                      class:list={["size-3 shrink-0", logo.mono && "logo-mono"]}
                    />
                  )}
                  <span class="min-w-0 break-words">{node}</span>
                </span>
              );
            })}
          </li>
          {index < flow.length - 1 && (
            <li aria-hidden="true" class="grid shrink-0 place-items-center text-brand-400/60">
              <ChevronDown size={14} class="sm:hidden" />
              <ChevronRight size={14} class="hidden sm:block" />
            </li>
          )}
        </>
      ))
    }
  </ol>
</figure>
