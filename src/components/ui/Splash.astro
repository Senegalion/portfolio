---
import { getTranslations, langFrom } from "../../i18n";

const t = getTranslations(langFrom(Astro.currentLocale));
const lines = t.splash.lines;
---

<!--
  Pure-CSS splash: it animates and fades out on its own, so it never blocks the
  page if JavaScript fails. An inline script in <head> sets data-splash="off"
  for reduced-motion users and when the URL contains ?nosplash.
-->
<div id="splash" class="splash" aria-hidden="true">
  <div class="flex w-[min(19rem,80vw)] flex-col items-center gap-7">
    <svg class="splash-logo size-20" viewBox="0 0 64 64" fill="none">
      <rect x="1.5" y="1.5" width="61" height="61" rx="14" stroke="#32cfce" stroke-opacity=".3" stroke-width="2.5"></rect>
      <g stroke="#71e5e2" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
        <path pathLength="100" d="M17 17v29h12"></path>
        <path pathLength="100" d="M11 34l12-7"></path>
        <path pathLength="100" d="M37 46V17h8a8.5 8.5 0 0 1 0 17h-8"></path>
      </g>
    </svg>

    <div class="w-full space-y-1.5 font-mono text-xs text-slate-400">
      {
        lines.map((line, index) => (
          <p class="splash-line" style={`animation-delay:${250 + index * 380}ms`}>
            <span class="text-brand-400">›</span> {line}
            {index === lines.length - 1 && <span class="text-emerald-300"> ✓</span>}
          </p>
        ))
      }
    </div>

    <div class="h-0.5 w-full overflow-hidden rounded-full bg-white/10">
      <div class="splash-bar h-full rounded-full bg-gradient-to-r from-brand-500 via-brand-300 to-cyan-200"></div>
    </div>

    <p class="font-mono text-[0.65rem] tracking-[0.3em] text-slate-400 uppercase">{t.splash.skip} · Esc</p>
  </div>
</div>

<script>
  const splash = document.getElementById("splash");
  const hide = () => splash?.classList.add("is-hidden");
  splash?.addEventListener("click", hide);
  const onKey = (event: KeyboardEvent) => {
    if (event.key !== "Escape") return;
    hide();
    document.removeEventListener("keydown", onKey);
  };
  document.addEventListener("keydown", onKey);
</script>
