---
import {
  ArrowUp,
  BellRing,
  BookOpen,
  BriefcaseBusiness,
  Copy,
  Download,
  FileText,
  FolderGit2,
  Github,
  GraduationCap,
  Languages,
  Linkedin,
  Mail,
  Medal,
  Microscope,
  Search,
  SunMoon,
  Sparkles,
  User,
  Users,
  Wrench,
} from "lucide-astro";
import { SITE, pagePath } from "../../data/site";
import { getTranslations, langFrom } from "../../i18n";

interface Props {
  hasCv: boolean;
}

const { hasCv } = Astro.props;
const lang = langFrom(Astro.currentLocale);
const t = getTranslations(lang);
const p = t.palette.actions;

type Item = {
  label: string;
  icon: typeof Search;
  href?: string;
  external?: boolean;
  download?: boolean;
  action?: string;
  keywords?: string;
  shortcut?: string;
};

const groups: { title: string; items: Item[] }[] = [
  {
    title: t.palette.groups.navigate,
    items: [
      { label: p.top, icon: ArrowUp, action: "back-to-top", keywords: "home start top" },
      { label: t.navigation.start, icon: Sparkles, href: pagePath("home", lang), keywords: "home start strona glowna" },
      { label: t.navigation.about, icon: User, href: pagePath("about", lang), keywords: "about o mnie" },
      { label: t.navigation.experience, icon: BriefcaseBusiness, href: pagePath("experience", lang), keywords: "work job ing praca" },
      { label: t.navigation.projects, icon: FolderGit2, href: pagePath("projects", lang), keywords: "projects github projekty" },
      { label: t.research.badge, icon: Microscope, href: pagePath("projects", lang, "#research"), keywords: "rca research ml badania" },
      { label: t.navigation.education, icon: GraduationCap, href: pagePath("education", lang), keywords: "studies certificates az-900 abb stypendium" },
      { label: t.navigation.skills, icon: Wrench, href: pagePath("education", lang, "#skills"), keywords: "stack tech java devops" },
      { label: t.navigation.teams, icon: Users, href: pagePath("teams", lang), keywords: "kola naukowe student teams solar kino ai ubicomp" },
      { label: t.activities.badge, icon: Medal, href: pagePath("about", lang, "#activities"), keywords: "karate hobby" },
      { label: t.navigation.contact, icon: Mail, href: pagePath("contact", lang), keywords: "contact email kontakt" },
    ],
  },
  {
    title: t.palette.groups.actions,
    items: [
      { label: p.copyEmail, icon: Copy, action: "copy-email", keywords: "email mail copy kopiuj" },
      { label: p.theme, icon: SunMoon, action: "toggle-theme", keywords: "theme dark light motyw ciemny jasny" },
      {
        label: p.language,
        icon: Languages,
        href: pagePath("home", lang === "pl" ? "en" : "pl"),
        keywords: "language english polski jezyk",
      },
      { label: p.install, icon: Download, action: "install", keywords: "pwa install app aplikacja" },
      { label: p.notifications, icon: BellRing, action: "notifications", keywords: "notifications push powiadomienia" },
      ...(hasCv ? [{ label: p.cv, icon: FileText, href: SITE.cvPath, download: true, keywords: "cv resume" }] : []),
    ],
  },
  {
    title: t.palette.groups.links,
    items: [
      { label: p.github, icon: Github, href: SITE.github, external: true, keywords: "code repos" },
      { label: p.linkedin, icon: Linkedin, href: SITE.linkedin, external: true, keywords: "profile" },
      { label: p.email, icon: BookOpen, href: `mailto:${SITE.email}`, keywords: "email mail" },
    ],
  },
];

let counter = 0;
---

<dialog
  id="command-palette"
  aria-label={t.palette.title}
  class="m-auto mt-[12vh] w-[min(36rem,calc(100%-2rem))] max-w-none overflow-hidden rounded-xl border border-line-strong bg-surface p-0 text-fg shadow-2xl shadow-black/30 open:animate-[toast-in_.2s_ease]"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Search size={18} class="shrink-0 text-subtle" aria-hidden="true" />
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder={t.palette.placeholder}
      aria-label={t.palette.placeholder}
      class="h-14 min-w-0 flex-1 bg-transparent text-base text-fg outline-none placeholder:text-subtle"
    />
    <kbd>Esc</kbd>
  </div>

  <div id="palette-list" role="listbox" aria-label={t.palette.title} class="max-h-[min(60vh,26rem)] overflow-y-auto p-2">
    {
      groups.map((group) => (
        <div role="group" aria-label={group.title} data-palette-group class="py-1">
          <p class="px-3 pt-2 pb-1.5 text-xs font-medium text-subtle" aria-hidden="true">
            {group.title}
          </p>
          {group.items.map((item) => {
            const Icon = item.icon;
            const id = `palette-option-${counter++}`;
            const common = {
              id,
              role: "option",
              "aria-selected": "false",
              tabindex: "-1",
              "data-palette-item": "",
              "data-keywords": `${item.label} ${item.keywords ?? ""}`.toLowerCase(),
              class:
                "flex w-full cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-muted outline-none aria-selected:bg-raised aria-selected:text-fg",
            };
            const content = (
              <>
                <span class="grid size-8 shrink-0 place-items-center rounded-lg border border-line text-accent">
                  <Icon size={16} aria-hidden="true" />
                </span>
                <span class="flex-1">{item.label}</span>
              </>
            );
            return item.href ? (
              <a
                {...common}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer" : undefined}
                download={item.download || undefined}
                data-lang-link={item.icon === Languages ? "" : undefined}
              >
                {content}
              </a>
            ) : (
              <button {...common} type="button" data-action={item.action} data-email={SITE.email}>
                {content}
              </button>
            );
          })}
        </div>
      ))
    }
    <p id="palette-empty" hidden class="px-3 py-8 text-center text-sm text-subtle">{t.palette.empty}</p>
  </div>

  <p class="border-t border-line px-4 py-2.5 text-xs text-subtle">{t.palette.hint}</p>
</dialog>

<script>
  const dialog = document.getElementById("command-palette") as HTMLDialogElement | null;
  const input = document.getElementById("palette-input") as HTMLInputElement | null;
  const empty = document.getElementById("palette-empty");

  if (dialog && input) {
    const items = [...dialog.querySelectorAll<HTMLElement>("[data-palette-item]")];
    const groups = [...dialog.querySelectorAll<HTMLElement>("[data-palette-group]")];
    let active = 0;

    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/ł/g, "l");

    const visibleItems = () => items.filter((item) => !item.hidden);

    const setActive = (index: number) => {
      const visible = visibleItems();
      if (!visible.length) {
        input.removeAttribute("aria-activedescendant");
        return;
      }
      active = (index + visible.length) % visible.length;
      visible.forEach((item, i) => item.setAttribute("aria-selected", String(i === active)));
      input.setAttribute("aria-activedescendant", visible[active].id);
      visible[active].scrollIntoView({ block: "nearest" });
    };

    const filter = () => {
      const query = normalize(input.value.trim());
      for (const item of items) {
        item.hidden = query !== "" && !normalize(item.dataset.keywords ?? "").includes(query);
        item.setAttribute("aria-selected", "false");
      }
      for (const group of groups) {
        group.hidden = !group.querySelector("[data-palette-item]:not([hidden])");
      }
      if (empty) empty.hidden = visibleItems().length > 0;
      setActive(0);
    };

    const open = () => {
      if (dialog.open) return;
      input.value = "";
      filter();
      dialog.showModal();
      input.focus();
    };

    input.addEventListener("input", filter);
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") setActive(active + 1);
      else if (event.key === "ArrowUp") setActive(active - 1);
      else if (event.key === "Enter") visibleItems()[active]?.click();
      else return;
      event.preventDefault();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
      else if ((event.target as Element).closest("[data-palette-item]")) dialog.close();
    });
    dialog.addEventListener("mousemove", (event) => {
      const item = (event.target as Element).closest<HTMLElement>("[data-palette-item]");
      if (item) setActive(visibleItems().indexOf(item));
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      const typing = target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName);
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          open();
        }
      } else if (event.key === "/" && !typing && !dialog.open) {
        event.preventDefault();
        open();
      }
    });

    document.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-open-palette]")) open();
    });
  }
</script>
